// Worldiqo database schema — MongoDB via Prisma.
//
// MongoDB-specific notes vs. a SQL datasource:
//  - every model needs an `id` field mapped to Mongo's `_id`, typed
//    `String @id @default(auto()) @map("_id") @db.ObjectId`
//  - foreign-key-style scalar fields need `@db.ObjectId` too
//  - Prisma requires MongoDB to run as a replica set (even a single-node
//    one) because its query engine uses transactions internally — see the
//    README for the one-time `rs.initiate()` step.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// --- Auth.js (NextAuth) required tables -------------------------------

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // set when the user signs up with email + password
  role          String    @default("user") // "user" | "admin" — Phase 3 admin gate

  // --- Billing (Phase 5) ---
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String    @default("none") // "none" | "active" | "past_due" | "canceled"
  currentPeriodEnd     DateTime?

  accounts      Account[]
  sessions      Session[]
  savedSearches SavedSearch[]

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Alerts (Phase 4) ---------------------------------------------------

model SavedSearch {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  category String // one of the CategoryId values from src/lib/gdelt.ts
  query    String? // optional free-text filter
  timespan String @default("24h") // also the digest cadence window

  active        Boolean   @default(true)
  lastRunAt     DateTime?
  lastSentCount Int       @default(0)

  createdAt DateTime @default(now())
}
