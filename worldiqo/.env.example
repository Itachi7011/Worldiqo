# --- Database (Phase 1) ---
# Prisma + your local MongoDB instance. Requires MongoDB running as a
# replica set (see README "Database" section for the one-time setup command).
DATABASE_URL="mongodb://127.0.0.1:27017/worldiqo?replicaSet=rs0&directConnection=true"

# --- Auth (Phase 2) ---
AUTH_SECRET="run: npx auth secret"
# Optional OAuth providers:
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# --- Alerts (Phase 4) ---
# Optional: without these, alert emails just log to the server console instead
# of sending — handy for local dev without an email provider account.
# RESEND_API_KEY=""
# RESEND_FROM="Worldiqo <alerts@yourdomain.com>"
# Optional: protects /api/cron/alerts from being triggered by randoms.
# Vercel Cron sends this automatically as a Bearer token when set.
# CRON_SECRET=""

# --- Payments (Phase 5) ---
# App URL used to build Stripe redirect URLs — set to your real domain in prod.
APP_URL="http://localhost:3000"
# STRIPE_SECRET_KEY=""
# STRIPE_PRICE_ID=""       # the recurring Price ID for your Premium plan
# STRIPE_WEBHOOK_SECRET="" # from `stripe listen` locally, or the Dashboard in prod

# --- Markets: optional extra reliability (not required) ---
# Free tier, no credit card, ~2 min signup at twelvedata.com. If set, it's
# automatically offered as a source option (alongside keyless Yahoo Finance)
# for stock and metals history. Leave unset and everything still works.
# TWELVE_DATA_API_KEY=""
